# Supabase (auto-populated in Edge Functions — set these for local dev)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# OpenAI — the key the free tier proxies through
OPENAI_API_KEY=sk-...

# Salt for hashing client IPs (abuse visibility, never enforced)
IP_HASH_SALT=random-string-here
